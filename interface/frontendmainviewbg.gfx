spriteTypes = {
	# KRCW: the main-menu background is ours; everything else below must keep CWIC's
	# texturefile paths. An earlier edit of mine stripped the texturefile lines from the logos
	# and deleted the ten menu-button spriteTypes outright, so every button lost its plate and
	# rendered as bare text over this bright background - that was the "can't read the text on
	# the start page" bug. Do not remove texturefile lines here.
	corneredTileSpriteType = {
		name = "GFX_frontend_bg"
		texturefile = "gfx/loadingscreens/load_awd.dds"
		borderSize = { x=0 y= 0 }
		size = { x=1920 y=1200 }
		tilingCenter = no
		effectFile = "gfx/FX/buttonstate_nodowneffect.lua"
	}
		textSpriteType = {
			name = "GFX_main_lobby_button_arrow"
			textureFile = "gfx/interface/main_lobby_button_arrow.dds"
			noOfFrames = 3
			effectFile = "gfx/FX/buttonstate_onlydisable.lua"
		}

